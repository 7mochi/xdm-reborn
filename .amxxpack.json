{
  "compiler": {
    "dir": "./.compiler",
    "version": "1.9.0-git5303",
    "dev": true,
    "addons": [],
    "executable": "amxxpc"
  },
  "include": [
    "./.compiler/include",
    "./assets/addons/amxmodx/scripting/include"
  ],
  "input": {
    "scripts": "./src/scripts",
    "assets": [
      "./assets",
      { "dir": "./.thirdparty/bugfixedhl", "filter": ["dlls/hl.dll", "dlls/hl.so"] }
    ]
  },
  "output": {
    "plugins": "./valve/addons/amxmodx/plugins",
    "assets": "./valve",
    "scripts": "./valve/addons/amxmodx/scripting",
    "include": "./valve/addons/amxmodx/scripting/include"
  },
  "thirdparty": {
    "dir": "./.thirdparty",
    "dependencies": [
      {
        "name": "bugfixedhl",
        "url": "https://github.com/tmp64/BugfixedHL-Rebased/releases/download/v1.13.2/BugfixedHL-1.13.2-server.zip",
        "strip": 2,
        "filter": ["dlls/hl.dll", "dlls/hl.so"]
      }
    ]
  },
  "rules": {
    "flatCompilation": true
  }
}